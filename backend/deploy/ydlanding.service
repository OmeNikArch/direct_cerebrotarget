[Unit]
Description=Cerebro Direct landing (Payload + Next.js)
After=network.target postgresql.service

[Service]
Type=simple
User=dev
WorkingDirectory=/home/dev/yd-landing/backend
Environment=NODE_ENV=production
Environment=PORT=3002
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

# Postgres 16
DATABASE_URL=postgres://ydlanding:CHANGE_ME@127.0.0.1:5435/ydlanding
# Длинная случайная строка: openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME
# Публичный адрес сайта (для ссылок админки)
NEXT_PUBLIC_SERVER_URL=http://localhost:3020
# Домены, с которых фронт может слать заявки, если он живёт отдельно от бэкенда (через запятую)
CORS_ORIGINS=
# Адрес приёма заявок, который подставляется в data-endpoint копии лендинга (sync-site)
LEAD_ENDPOINT=/api/leads/submit
# Первый администратор (npm run create-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
